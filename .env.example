# docker compose için örnek ortam değişkenleri. Kopyalayıp ".env" olarak kaydedin ve değerleri değiştirin:
#   cp .env.example .env
#
# GERÇEK BİR SUNUCUDA bu üç değeri mutlaka değiştirin ve demo kullanıcılarını kapatın.

# Veritabanı parolası
DB_PASSWORD=degistirin-guclu-bir-parola

# JWT imzalama anahtarı: en az 32 karakter, rastgele (örn. `openssl rand -base64 48`)
JWT_KEY=degistirin-en-az-32-karakterlik-rastgele-bir-anahtar

# Demo kullanıcılarını (admin/operator/izleyici, herkesçe bilinen parolalarla) oluştur ve giriş sayfasında göster.
# Üretimde false yapın; ilk yönetici için Seed__AdminUserName / Seed__AdminPassword kullanın.
SEED_DEMO_USERS=true
SHOW_DEMO_ACCOUNTS=true

# Örnek varlık ve bakım verisini yükle
SEED_SAMPLE_DATA=true

# Dışarıdan erişilen port
WEB_PORT=8080
